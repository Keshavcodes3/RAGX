{
  "name": "ragx",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "version": "1.0.0",
  "description": "RAGX\r The retrieval layer for AI.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keshavcodes3/RAGX.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Keshavcodes3/RAGX/issues"
  },
  "homepage": "https://github.com/Keshavcodes3/RAGX#readme"
}
